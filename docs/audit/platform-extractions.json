      {
        "from": "isPinned: states[0],",
        "to": "isPinned: _pinChanged ? value.isPinned : states[0],"
      },
      {
        "from": "isMaximized: states[1],",
        "to": "isMaximized: _maxEvent ? value.isMaximized : states[1],"
      },
      {
        "from": "isFullScreen: states[2],",
        "to": "isFullScreen: _fullScreenEvent ? value.isFullScreen : states[2],"
      },
      {
        "from": "    super.onWindowMaximize();",
        "to": "    super.onWindowMaximize();\n    _maxEvent = true;"
      },
      {
        "from": "    super.onWindowUnmaximize();",
        "to": "    super.onWindowUnmaximize();\n    _maxEvent = true;"
      },
      {
        "from": "    super.onWindowEnterFullScreen();",
        "to": "    super.onWindowEnterFullScreen();\n    _fullScreenEvent = true;"
      },
      {
        "from": "    super.onWindowLeaveFullScreen();",
        "to": "    super.onWindowLeaveFullScreen();\n    _fullScreenEvent = true;"
      },
      {
        "from": "    _set(value.copyWith(isPinned: await desktopWindow.isAlwaysOnTop()));",
        "to": "    final applied = await desktopWindow.isAlwaysOnTop();\n    _pinChanged = true;\n    _set(value.copyWith(isPinned: applied));"
      }
